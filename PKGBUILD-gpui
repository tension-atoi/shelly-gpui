# Maintainer: tension-atoi <tension-atoi@users.noreply.github.com>
# Forked from: Seafoam-Labs/Shelly-ALPM
# Paquet: frontend GPUI natif Rust pour le gestionnaire de paquets Shelly (ALPM + AUR + Flatpak + AppImage)

pkgname=shelly-gpui-git
pkgver=r0.git
pkgrel=1
pkgdesc="Frontend GPUI natif Rust pour Shelly — gestionnaire de paquets Arch Linux (ALPM, AUR, Flatpak, AppImage)"
arch=('x86_64')
url="https://github.com/tension-atoi/shelly-gpui"
license=('GPL-3.0-only')
depends=(
    'glibc'
    'gcc-libs'
    'fontconfig'
    'freetype2'
    'libx11'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'wayland'
    'libglvnd'
    'mesa'
    'vulkan-icd-loader'
    'pacman'
    'polkit'
)
makedepends=(
    'git'
    'rust'
    'cargo'
    'zig'
    'pkgconf'
    'clang'
)
optdepends=(
    'flatpak: support des applications Flatpak'
    'paru: support AUR via Shelly'
    'yay: support AUR alternatif'
)
provides=('shelly-gpui')
conflicts=('shelly-gpui')
source=("${pkgname}::git+https://github.com/tension-atoi/shelly-gpui.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/${pkgname}/Shelly.Ui.Gpui"
    cargo fetch --locked
}

build() {
    cd "${srcdir}/${pkgname}"

    # 1. Compile Shelly CLI backend (Zig)
    echo ">>> Compiling Shelly CLI backend (Zig)..."
    cd Shelly.Cli.Zig
    zig build -Doptimize=ReleaseSafe
    cd ..

    # 2. Compile Shelly GPUI frontend (Rust)
    echo ">>> Compiling Shelly GPUI frontend (Rust)..."
    cd Shelly.Ui.Gpui
    export CARGO_TARGET_DIR="target"
    SHELLY_BIN="${srcdir}/${pkgname}/Shelly.Cli.Zig/zig-out/bin/shelly" \
        cargo build --release --locked
}

check() {
    cd "${srcdir}/${pkgname}/Shelly.Ui.Gpui"
    export CARGO_TARGET_DIR="target"
    SHELLY_BIN="${srcdir}/${pkgname}/Shelly.Cli.Zig/zig-out/bin/shelly" \
        cargo test --release --locked
}

package() {
    cd "${srcdir}/${pkgname}"

    # ── Binaries ─────────────────────────────────────────────────────────────
    install -Dm755 "Shelly.Cli.Zig/zig-out/bin/shelly" \
        "${pkgdir}/usr/lib/shelly/shelly"

    install -Dm755 "Shelly.Ui.Gpui/target/release/shelly-gpui" \
        "${pkgdir}/usr/lib/shelly/shelly-gpui-bin"

    # Wrapper /usr/bin/shelly-gpui setting SHELLY_BIN and executing binary
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/shelly-gpui" << 'EOF'
#!/bin/sh
SHELLY_BIN=/usr/lib/shelly/shelly exec /usr/lib/shelly/shelly-gpui-bin "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/shelly-gpui"

    # ── Desktop Entry ────────────────────────────────────────────────────────
    install -Dm644 "Shelly.Ui.Gpui/assets/com.shellyorg.shelly-gpui.desktop" \
        "${pkgdir}/usr/share/applications/com.shellyorg.shelly-gpui.desktop"

    # ── SVG Icon ─────────────────────────────────────────────────────────────
    install -Dm644 "Shelly.Ui.Gpui/assets/shelly-gpui.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/shelly-gpui.svg"

    # ── License ──────────────────────────────────────────────────────────────
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE \
            "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # ── Polkit Policy ────────────────────────────────────────────────────────
    install -Dm644 "Shelly.Ui.Gpui/assets/com.shellyorg.shelly-gpui.policy" \
        "${pkgdir}/usr/share/polkit-1/actions/com.shellyorg.shelly-gpui.policy"
}
